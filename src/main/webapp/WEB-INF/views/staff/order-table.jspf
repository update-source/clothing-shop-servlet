<%-- Bảng đơn hàng cho nhân viên. Biến: latest hoặc result.items (danh sách đơn) --%>
<c:set var="rows" value="${empty result ? latest : result.items}"/>
<div class="table-responsive">
  <table class="table table-hover mb-0">
    <thead class="thead-light">
      <tr><th>Mã</th><th>Ngày đặt</th><th>Khách hàng</th><th>Người nhận</th><th class="text-right">Tổng tiền</th>
        <th>Thanh toán</th><th>Trạng thái</th><th>Xử lý bởi</th></tr>
    </thead>
    <tbody>
      <c:if test="${empty rows}"><tr><td colspan="8" class="text-center text-muted">Không có đơn nào.</td></tr></c:if>
      <c:forEach items="${rows}" var="o">
        <tr>
          <td><a href="${ctx}/staff/orders/detail?id=${o.id}" class="font-weight-bold">#${o.id}</a></td>
          <td class="small">${f:dateTime(o.orderDate)}</td>
          <td class="small"><c:out value="${o.customer.fullName}"/><br><span class="text-muted">@<c:out value="${o.customer.username}"/></span></td>
          <td class="small"><c:out value="${o.shippingAddress.recipientName}"/><br><span class="text-muted"><c:out value="${o.shippingAddress.phone}"/></span></td>
          <td class="text-right">${f:vnd(o.total)}</td>
          <td class="small">${o.paymentMethod}
            <c:choose>
              <c:when test="${o.paid}"><span class="badge badge-success">Đã trả</span></c:when>
              <c:otherwise><span class="badge badge-light">Chưa trả</span></c:otherwise>
            </c:choose>
          </td>
          <td><span class="badge badge-${o.status.badge}">${o.status.label}</span></td>
          <td class="small"><c:out value="${empty o.handledBy ? '—' : o.handledBy.fullName}"/></td>
        </tr>
      </c:forEach>
    </tbody>
  </table>
</div>
