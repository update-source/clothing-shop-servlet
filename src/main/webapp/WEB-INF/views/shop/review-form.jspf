<%-- Khu viết/sửa đánh giá. Biến: product, myReview (đánh giá của khách nếu có), canReview (đã mua, chưa đánh giá) --%>
<c:choose>
  <c:when test="${not empty myReview or canReview}">
    <form action="${ctx}/reviews/save" method="post" class="border rounded p-4 mb-4">
      <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
      <input type="hidden" name="productId" value="${product.id}">
      <h4 class="h6 text-black">${empty myReview ? 'Viết đánh giá của bạn' : 'Sửa đánh giá của bạn'}</h4>
      <c:set var="currentRating" value="${empty myReview ? 5 : myReview.rating}"/>
      <div class="star-input mb-2" role="radiogroup" aria-label="Số sao">
        <c:forEach begin="1" end="5" var="i">
          <c:set var="star" value="${6 - i}"/>
          <input type="radio" id="star${star}" name="rating" value="${star}" ${star == currentRating ? 'checked' : ''}>
          <label for="star${star}" title="${star} sao">★</label>
        </c:forEach>
      </div>
      <div class="form-group">
        <textarea name="comment" rows="3" maxlength="1000" class="form-control"
                  placeholder="Chất liệu, form dáng, màu sắc có như mong đợi không?"><c:out value="${myReview.comment}"/></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-sm">${empty myReview ? 'Gửi đánh giá' : 'Cập nhật đánh giá'}</button>
    </form>
  </c:when>
  <c:when test="${not empty auth and auth.customer}">
    <p class="small text-muted mb-4">Bạn có thể đánh giá sản phẩm này sau khi nhận hàng thành công.</p>
  </c:when>
</c:choose>
