<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>Hàm EL của cửa hàng</description>
    <tlib-version>1.0</tlib-version>
    <short-name>f</short-name>
    <uri>http://shop.local/functions</uri>

    <function>
        <name>vnd</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String vnd(java.math.BigDecimal)</function-signature>
    </function>
    <function>
        <name>plain</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String plain(java.math.BigDecimal)</function-signature>
    </function>
    <function>
        <name>dateTime</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String dateTime(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <name>date</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String date(java.time.LocalDate)</function-signature>
    </function>
    <function>
        <name>isoDate</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String isoDate(java.time.LocalDate)</function-signature>
    </function>
    <function>
        <name>isoDateTime</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String isoDateTime(java.time.LocalDateTime)</function-signature>
    </function>
    <function>
        <name>stars</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String stars(double)</function-signature>
    </function>
    <function>
        <name>rating</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String rating(double)</function-signature>
    </function>
    <function>
        <name>url</name>
        <function-class>com.shop.web.ElFunctions</function-class>
        <function-signature>java.lang.String url(java.lang.String)</function-signature>
    </function>
</taglib>
