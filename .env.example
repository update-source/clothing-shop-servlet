# Chép thành .env (đã .gitignore) rồi sửa giá trị: cp .env.example .env
# Mọi khoá trong app.properties đều ghi đè được bằng biến SHOP_<KHOÁ> (db.poolSize -> SHOP_DB_POOLSIZE).

# Cổng trên máy chủ (bên trong container Tomcat luôn chạy ở 8080)
APP_PORT=8080

# Tạo dữ liệu mẫu (tài khoản admin/staff/khachhang, sản phẩm, voucher) khi CSDL còn trống.
# Khi chạy thật nên đặt false trước lần chạy đầu, hoặc đổi mật khẩu các tài khoản mẫu ngay sau đó.
SHOP_DB_SEED=true

# Đơn VNPAY không thanh toán sau số phút này sẽ tự huỷ
SHOP_ORDER_VNPAYTIMEOUTMINUTES=15

# VNPAY: mock = cổng giả lập trong ứng dụng; sandbox = cổng thử nghiệm thật (cần TMN code và hash secret do VNPAY cấp)
SHOP_VNPAY_MODE=mock
SHOP_VNPAY_TMNCODE=DEMOSHOP
SHOP_VNPAY_HASHSECRET=MOCK_SECRET_FOR_LOCAL_DEMO_ONLY

# Chỉ dùng với docker-compose.mysql.yml — đặt mật khẩu mạnh
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
